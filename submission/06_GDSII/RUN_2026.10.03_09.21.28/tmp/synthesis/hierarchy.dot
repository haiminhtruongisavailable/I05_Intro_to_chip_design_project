digraph "cordic" {
label="cordic";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="sign_cos", color="black", fontcolor="black" ];
n2 [ shape=diamond, label="sign_sin", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="y", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="x", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="i", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="run", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="load", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="cos", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="sin", color="black", fontcolor="black" ];
n10 [ shape=octagon, label="done", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="angle", color="black", fontcolor="black" ];
n12 [ shape=octagon, label="start", color="black", fontcolor="black" ];
n13 [ shape=octagon, label="rst_n", color="black", fontcolor="black" ];
n14 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
c15 [ shape=record, label="{{<p11> angle|<p14> clk|<p5> i|<p7> load|<p13> rst_n|<p6> run}|u_proc\ncordic_processing|{<p1> sign_cos|<p2> sign_sin|<p4> x|<p3> y}}",  ];
c16 [ shape=record, label="{{<p14> clk|<p13> rst_n|<p1> sign_cos|<p2> sign_sin|<p12> start|<p4> x|<p3> y}|u_ctrl\ncordic_control|{<p8> cos|<p10> done|<p5> i|<p7> load|<p6> run|<p9> sin}}",  ];
c15:p1:e -> n1:w [color="black", fontcolor="black", label=""];
n1:e -> c16:p1:w [color="black", fontcolor="black", label=""];
c16:p10:e -> n10:w [color="black", fontcolor="black", label=""];
n11:e -> c15:p11:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n12:e -> c16:p12:w [color="black", fontcolor="black", label=""];
n13:e -> c15:p13:w [color="black", fontcolor="black", label=""];
n13:e -> c16:p13:w [color="black", fontcolor="black", label=""];
n14:e -> c15:p14:w [color="black", fontcolor="black", label=""];
n14:e -> c16:p14:w [color="black", fontcolor="black", label=""];
c15:p2:e -> n2:w [color="black", fontcolor="black", label=""];
n2:e -> c16:p2:w [color="black", fontcolor="black", label=""];
c15:p3:e -> n3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c16:p3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c15:p4:e -> n4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c16:p4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c16:p5:e -> n5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n5:e -> c15:p5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c16:p6:e -> n6:w [color="black", fontcolor="black", label=""];
n6:e -> c15:p6:w [color="black", fontcolor="black", label=""];
c16:p7:e -> n7:w [color="black", fontcolor="black", label=""];
n7:e -> c15:p7:w [color="black", fontcolor="black", label=""];
c16:p8:e -> n8:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c16:p9:e -> n9:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
